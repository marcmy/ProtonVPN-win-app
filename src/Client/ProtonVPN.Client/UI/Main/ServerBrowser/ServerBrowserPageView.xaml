<Page x:Class="ProtonVPN.Client.UI.Main.ServerBrowser.ServerBrowserPageView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:browser="using:ProtonVPN.Client.UI.Main.ServerBrowser"
      xmlns:common="using:ProtonVPN.Client.Common.UI.Controls"
      xmlns:custom="using:ProtonVPN.Client.Common.UI.Controls.Custom"
      xmlns:pathicons="using:ProtonVPN.Client.Common.UI.Assets.Icons.PathIcons"
      x:DefaultBindMode="OneWay"
      AutomationProperties.AutomationId="ServerBrowserPage"
      AutomationProperties.Name="{x:Bind ViewModel.Title}"
      KeyboardAcceleratorPlacementMode="Hidden"
      NavigationCacheMode="Required">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="Left" Modifiers="Menu" Invoked="OnBackInvoked" />
        <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="OnFindInvoked" />
    </Page.KeyboardAccelerators>

    <Grid x:Name="BrowserLayout"
          Padding="16,12,16,12"
          Background="{ThemeResource BackgroundNormColorBrush}"
          RowSpacing="12"
          SizeChanged="OnBrowserSizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="BackButton"
                    AutomationProperties.AutomationId="ServerBrowserBack"
                    Click="OnBackClicked"
                    Content="{x:Bind ViewModel.BackLabel}" />
            <TextBlock Grid.Column="1"
                       VerticalAlignment="Center"
                       AutomationProperties.HeadingLevel="Level1"
                       Style="{ThemeResource TitleTextBlockStyle}"
                       Text="{x:Bind ViewModel.Title}"
                       TextWrapping="Wrap" />
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="DetailsColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <Grid x:Name="ListPane" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Pivot x:Name="FeatureTabs" SelectionChanged="OnFilterSelectionChanged"
                       AutomationProperties.AutomationId="ServerBrowserFeatures">
                    <PivotItem Header="{x:Bind ViewModel.Localizer.Get('Countries_All')}" />
                    <PivotItem Header="{x:Bind ViewModel.Localizer.Get('Countries_SecureCore')}" />
                    <PivotItem Header="{x:Bind ViewModel.Localizer.Get('Countries_P2P')}" />
                    <PivotItem Header="{x:Bind ViewModel.Localizer.Get('Countries_Tor')}" />
                </Pivot>

                <StackPanel Grid.Row="1" Spacing="8">
                    <TextBox x:Name="ServerSearch"
                             AutomationProperties.AutomationId="ServerBrowserSearch"
                             AutomationProperties.Name="{x:Bind ViewModel.Localizer.Get('ServerBrowser_Search')}"
                             PlaceholderText="{x:Bind ViewModel.Localizer.Get('ServerBrowser_Search')}"
                             Text="{x:Bind ViewModel.Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="SortFilter" HorizontalAlignment="Stretch"
                                  DropDownClosed="OnFilterDropDownClosed"
                                  Header="{x:Bind ViewModel.Localizer.Get('ServerBrowser_Sort')}"
                                  AutomationProperties.AutomationId="ServerBrowserSort"
                                  SelectionChanged="OnFilterSelectionChanged" />
                        <ComboBox x:Name="PingFilter" Grid.Column="1"
                                  HorizontalAlignment="Stretch"
                                  DropDownClosed="OnFilterDropDownClosed"
                                  Header="{x:Bind ViewModel.Localizer.Get('ServerBrowser_MaxPing')}"
                                  AutomationProperties.AutomationId="ServerBrowserMaxPing"
                                  SelectionChanged="OnFilterSelectionChanged" />
                    </Grid>
                </StackPanel>

                <Grid Grid.Row="2" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ResultsStatus"
                               Foreground="{ThemeResource TextWeakColorBrush}"
                               Text="{x:Bind ViewModel.ResultText}"
                               TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1"
                               HorizontalAlignment="Right"
                               Foreground="{ThemeResource TextWeakColorBrush}"
                               Text="{x:Bind ViewModel.ProgressText}"
                               TextAlignment="Right"
                               TextTrimming="CharacterEllipsis" />
                </Grid>

                <Grid Grid.Row="3">
                    <Grid Visibility="{x:Bind ViewModel.IsEmpty, Converter={StaticResource NotBooleanToVisibilityConverter}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Padding="12,6,12,6"
                              BorderBrush="{ThemeResource BorderNormColorBrush}"
                              BorderThickness="0,0,0,1"
                              SizeChanged="OnColumnsSizeChanged">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="112" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="72" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}"
                                       Text="{x:Bind ViewModel.Localizer.Get('ServerBrowser_Location')}" />
                            <TextBlock Grid.Column="1" TextAlignment="Right" TextWrapping="Wrap"
                                       Style="{ThemeResource BodyStrongTextBlockStyle}"
                                       Text="{x:Bind ViewModel.Localizer.Get('ServerPing_CachedFilterLabel')}" />
                            <TextBlock Grid.Column="2" TextAlignment="Right" TextWrapping="Wrap"
                                       Style="{ThemeResource BodyStrongTextBlockStyle}"
                                       Text="{x:Bind ViewModel.Localizer.Get('ServerBrowser_Loss')}" />
                            <TextBlock Grid.Column="3" TextAlignment="Right" TextWrapping="Wrap"
                                       Style="{ThemeResource BodyStrongTextBlockStyle}"
                                       Text="{x:Bind ViewModel.Localizer.Get('ServerBrowser_Load')}" />
                        </Grid>

                        <ListView x:Name="ServerList"
                                  Grid.Row="1"
                                  AutomationProperties.AutomationId="ServerBrowserList"
                                  AutomationProperties.Name="{x:Bind ViewModel.Title}"
                                  ContainerContentChanging="OnContainerContentChanging"
                                  IsItemClickEnabled="True"
                                  ItemClick="OnServerInvoked"
                                  ItemsSource="{x:Bind ViewModel.Results.View}"
                                  KeyDown="OnListKeyDown"
                                  LostFocus="OnListLostFocus"
                                  SelectionMode="None"
                                  ScrollViewer.HorizontalScrollMode="Disabled"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListView.ItemContainerTransitions>
                                <TransitionCollection />
                            </ListView.ItemContainerTransitions>
                            <ListView.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <ItemsStackPanel AreStickyGroupHeadersEnabled="True" ItemsUpdatingScrollMode="KeepScrollOffset" />
                                </ItemsPanelTemplate>
                            </ListView.ItemsPanel>
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="UseSystemFocusVisuals" Value="True" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.GroupStyle>
                                <GroupStyle HidesIfEmpty="True" HeaderContainerStyle="{StaticResource GhostListViewHeaderItemStyle}">
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate x:DataType="browser:ServerBrowserGroup">
                                            <Border Padding="12,8,4,8"
                                                    Background="{ThemeResource BackgroundNormColorBrush}"
                                                    Visibility="{x:Bind HasTitle, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <TextBlock AutomationProperties.HeadingLevel="Level2"
                                                           Style="{ThemeResource BodyStrongTextBlockStyle}"
                                                           Text="{x:Bind Title}"
                                                           TextWrapping="Wrap" />
                                            </Border>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ListView.GroupStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="browser:ServerBrowserRow">
                                    <Grid Padding="12,8,12,8"
                                          AutomationProperties.Name="{x:Bind AutomationName}"
                                          SizeChanged="OnColumnsSizeChanged">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="112" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="72" />
                                        </Grid.ColumnDefinitions>
                                        <Grid ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <custom:SimpleCountryFlag Width="26"
                                                                      Height="18"
                                                                      VerticalAlignment="Top"
                                                                      CountryCode="{x:Bind CountryCode, Mode=OneTime}" />
                                            <StackPanel Grid.Column="1" Spacing="2">
                                                <TextBlock Style="{ThemeResource BodyStrongTextBlockStyle}"
                                                           Text="{x:Bind Location, Mode=OneTime}"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTipService.ToolTip="{x:Bind Location, Mode=OneTime}" />
                                                <Grid ColumnSpacing="4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Foreground="{ThemeResource TextWeakColorBrush}"
                                                               TextTrimming="CharacterEllipsis">
                                                        <Run Text="{x:Bind Name, Mode=OneTime}" />
                                                        <Run Text=" " />
                                                        <Run Text="{x:Bind IdentityState}" />
                                                    </TextBlock>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="3">
                                                        <pathicons:Globe Size="Pixels16"
                                                                         AutomationProperties.Name="{x:Bind SmartRoutingLabel, Mode=OneTime}"
                                                                         ToolTipService.ToolTip="{x:Bind SmartRoutingLabel, Mode=OneTime}"
                                                                         Visibility="{x:Bind SupportsSmartRouting, Mode=OneTime, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                        <pathicons:ArrowRightArrowLeft Size="Pixels16"
                                                                                      AutomationProperties.Name="{x:Bind P2PLabel, Mode=OneTime}"
                                                                                      ToolTipService.ToolTip="{x:Bind P2PLabel, Mode=OneTime}"
                                                                                      Visibility="{x:Bind SupportsP2P, Mode=OneTime, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                        <pathicons:BrandTor Size="Pixels16"
                                                                            AutomationProperties.Name="{x:Bind TorLabel, Mode=OneTime}"
                                                                            ToolTipService.ToolTip="{x:Bind TorLabel, Mode=OneTime}"
                                                                            Visibility="{x:Bind SupportsTor, Mode=OneTime, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>
                                        </Grid>
                                        <StackPanel Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center">
                                            <common:ServerHealthControl Snapshot="{x:Bind HealthSnapshot}" HorizontalAlignment="Right" />
                                            <TextBlock Foreground="{ThemeResource TextWeakColorBrush}"
                                                       Style="{ThemeResource CaptionTextBlockStyle}"
                                                       Text="{x:Bind MeasurementStatus}"
                                                       TextAlignment="Right"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Margin="4,0,0,0" VerticalAlignment="Center"
                                                   Text="{x:Bind LossText}" TextAlignment="Right" TextWrapping="Wrap" />
                                        <TextBlock Grid.Column="3" Margin="4,0,0,0" VerticalAlignment="Center"
                                                   Text="{x:Bind LoadText}" TextAlignment="Right" TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>

                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Spacing="8"
                                Visibility="{x:Bind ViewModel.IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="{x:Bind ViewModel.Localizer.Get('Search_NoResults_Title')}" />
                        <Button HorizontalAlignment="Center"
                                Command="{x:Bind ViewModel.ResetFiltersCommand}"
                                Content="{x:Bind ViewModel.Localizer.Get('ServerBrowser_ResetFilters')}" />
                    </StackPanel>
                </Grid>
            </Grid>

            <ScrollViewer x:Name="DetailsPane"
                          Grid.Column="1"
                          HorizontalScrollMode="Disabled"
                          HorizontalScrollBarVisibility="Disabled"
                          Visibility="Collapsed">
                <StackPanel x:Name="DetailsContent" Padding="16,8" Spacing="10">
                    <TextBlock AutomationProperties.HeadingLevel="Level2"
                               Style="{ThemeResource SubtitleTextBlockStyle}"
                               Text="{x:Bind ViewModel.SelectedRow.Location}"
                               TextWrapping="Wrap" />
                    <TextBlock Foreground="{ThemeResource TextWeakColorBrush}" TextWrapping="Wrap">
                        <Run Text="{x:Bind ViewModel.SelectedRow.Name}" />
                        <Run Text=" " />
                        <Run Text="{x:Bind ViewModel.SelectedRow.IdentityState}" />
                    </TextBlock>
                    <Button Command="{x:Bind ViewModel.ConnectCommand}"
                            Content="{x:Bind ViewModel.ActionLabel}"
                            AutomationProperties.AutomationId="ServerBrowserConnect" />
                    <TextBlock TextWrapping="Wrap">
                        <Run Text="{x:Bind ViewModel.Localizer.Get('Home_ConnectionDetails_ServerLoad')}" />
                        <Run Text="  " />
                        <Run Text="{x:Bind ViewModel.SelectedRow.LoadText}" />
                    </TextBlock>
                    <TextBlock Foreground="{ThemeResource TextWeakColorBrush}"
                               Text="{x:Bind ViewModel.MeasuredLeg}"
                               TextWrapping="Wrap" />
                    <common:ServerHealthHistoryDetailsControl Snapshot="{x:Bind ViewModel.SelectedSnapshot}" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
